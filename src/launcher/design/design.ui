          <property name="styleSheet">
           <string notr="true">#widget_login {
	
	background-image: url(:/data/background/login_back.jpg);
	border-radius: 50px;
}

/* Стиль для кнопки с синим цветом */
QPushButton {
    background-color: #FF77A3; 
    border: 2px solid #FF77A3;;
    color: rgb(181, 255, 214); 
    padding: 10px 20px; /* Внутренние отступы */
    text-align: center;
    font-size: 24px;
	font-weight: bold; /* Жирный текст */
    border-radius: 10px; /* Закругленные углы */
}

QPushButton:hover {
    background-color: #FF4DA3; /* Более тёмный синий при наведении */
}

QPushButton:pressed {
    background-color:  #FF00A3; /* Ещё более тёмный синий при нажатии */
}
QPushButton:disabled {
    background-color: #D3D3D3; /* Серый цвет фона */
    border: 2px solid #A9A9A9; /* Серый цвет границы */
    color: #A9A9A9; /* Серый цвет текста */
}

QLabel {
    color: rgb(19, 255, 19);
    text-decoration: underline;
    font-size: 18px; /* Размер текста */
}
QLabel:hover {
    color: rgb(0, 255, 255); /* Цвет при наведении */
    font-size: 20px; /* Изменение размера при наведении (опционально) */
    text-decoration: none; /* Убираем подчеркивание при наведении */
}


#pushButton_error_info {
    background-color: rgba(220, 50, 50, 0.9); /* Slightly lighter semi-transparent red background */
    color: white; /* White text */
    border: 2px solid #b22222; /* Firebrick color for the border */
    border-radius: 5px; /* Rounded corners */
    padding: 10px; /* Internal padding */
    font-weight: bold; /* Bold font */
    text-align: center; /* Centered text */
}

/* Optional: Hover state for button */
#pushButton_error_info:hover {
    background-color: rgba(220, 50, 50, 1); /* Fully opaque red on hover */
}

/* Optional: Pressed state for button */
#pushButton_error_info:pressed {
    background-color: rgba(180, 30, 30, 0.8); /* Darker red on press */
}
</string>
