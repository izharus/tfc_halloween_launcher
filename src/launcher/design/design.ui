                     <property name="styleSheet">
                      <string notr="true">/* Modern Style QLineEdit */
.QLineEdit {
  border: 2px solid #ccc;
  background-color: #f9f9f9;
  color: #333;
  padding: 10px;
  font-size: 16px;
  border-radius: 15px; /* Adjust the value to control the corner smoothness */
}

.QLineEdit:focus {
  outline: none;
  border-color: #4287f5;
  background-color: #fff;
}

.QLineEdit::placeholder {
  color: #999;
}

.QLineEdit:hover {
  border-color: #999;
}
</string>
