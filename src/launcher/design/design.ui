                <property name="styleSheet">
                 <string notr="true">#scrollArea, #scrollAreaWidgetContents{

background-color: rgba(255, 255, 255, 0);  /* Полностью прозрачный фон */
border: none; /* Убирает границу кнопки */
}


    QScrollBar:horizontal {
        border: none; /* Убираем границы */
        background: rgba(0, 51, 102, 200); /* Темно-синий фон для горизонтальной полосы */
        height: 10px; /* Высота полосы прокрутки */
        margin: 0px 22px; /* Отступы для управления кнопками */
    }

    QScrollBar::handle:horizontal {
        background: rgba(0, 76, 153, 200); /* Более светлый темно-синий для ползунка */
        min-width: 20px; /* Минимальная ширина ползунка */
        border-radius: 5px; /* Скругление углов ползунка */
    }

    QScrollBar::handle:horizontal:hover {
        background: rgba(0, 102, 204, 200); /* Светлый синий при наведении */
    }

    QScrollBar::add-line:horizontal,
    QScrollBar::sub-line:horizontal {
        background: none; /* Убираем фон для стрелок */
        border: none; /* Убираем границы для стрелок */
    }

    QScrollBar::left-arrow:horizontal,
    QScrollBar::right-arrow:horizontal {
        background: none; /* Убираем фон для стрелок */
        width: 0px; /* Убираем ширину стрелок */
        height: 0px; /* Убираем высоту стрелок */
    }

    QScrollBar::add-page:horizontal,
    QScrollBar::sub-page:horizontal {
        background: none; /* Убираем фон для области прокрутки */
    }</string>
