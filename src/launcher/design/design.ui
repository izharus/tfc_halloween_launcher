              <property name="styleSheet">
               <string notr="true">/* Custom Style QGroupBox */
QGroupBox {
  font-size: 16px;
  border: 2px solid #4287f5; /* Border color for the group box */
  border-radius: 8px; /* Border radius for rounded corners */
  margin-top: 10px; /* Adjust margin as needed */
}

QGroupBox::title {
  subcontrol-origin: margin;
  subcontrol-position: top center;
  padding: 0 5px; /* Padding for the title text */
}

/* Apply the style for the child QRadioButton inside the QGroupBox */
QGroupBox QRadioButton::indicator {
  width: 20px;
  height: 20px;
  border-radius: 10px; /* Make the indicator circular */
}

QGroupBox QRadioButton::indicator:unchecked {
  border: 2px solid #ccc;
  background-color: #f9f9f9;
}

QGroupBox QRadioButton::indicator:checked {
  border: 2px solid #4287f5;
  background-color: #4287f5;
}

QGroupBox QRadioButton::indicator:hover {
  border: 2px solid #999;
}

QGroupBox QRadioButton::indicator:checked:hover {
  background-color: #3264ad;
}
</string>
