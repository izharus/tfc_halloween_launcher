           <item>
            <widget class="QRadioButton" name="radioButton_female">
             <property name="styleSheet">
              <string notr="true">/* Custom Style QCheckBox and QRadioButton */
QCheckBox, QRadioButton {
  spacing: 5px;
  font-size: 16px;
}

QCheckBox::indicator, QRadioButton::indicator {
  width: 20px;
  height: 20px;
  border-radius: 10px; /* Set border-radius to half of width/height for a circular shape */
}

QCheckBox::indicator:unchecked, QRadioButton::indicator:unchecked {
  border: 2px solid #ccc;
  background-color: #f9f9f9;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
  border: 2px solid #4287f5;
  background-color: #4287f5;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
  border: 2px solid #999;
}

QCheckBox::indicator:checked:hover, QRadioButton::indicator:checked:hover {
  background-color: #3264ad;
}
</string>
             </property>
             <property name="text">
              <string>Женский</string>
             </property>
            </widget>
