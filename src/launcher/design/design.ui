              <property name="styleSheet">
               <string notr="true">QPushButton {
    background-image: url(:/data/background/back_arrow.png);
    background-position: center;
    background-repeat: no-repeat;
    border: none; /* Убираем границы */
    border-radius: 10px; /* Скругляем углы кнопки */
    padding: 10px; /* Добавляем внутренние отступы */
    color: white; /* Устанавливаем цвет текста */
    font-size: 16px; /* Устанавливаем размер шрифта */
    font-weight: bold; /* Устанавливаем жирный шрифт */
}

QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.2); /* Добавляем эффект при наведении */
}

QPushButton:pressed {
    background-color: rgba(255, 255, 255, 0.4); /* Добавляем эффект при нажатии */
}
</string>
